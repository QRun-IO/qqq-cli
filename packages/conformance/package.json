{
  "name": "@qrun-io/qqq-ui-api-conformance",
  "version": "1.6.0",
  "description": "Black-box conformance suite for QQQ UI API (/qqq/v1) servers, plus qqq-dev-idp, a local OIDC provider for testing native clients.",
  "keywords": [
    "qqq",
    "qrun",
    "ui-api",
    "conformance",
    "openapi",
    "testing",
    "oidc"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/QRun-IO/qqq-cli/tree/main/packages/conformance#readme",
  "bugs": {
    "url": "https://github.com/QRun-IO/qqq-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QRun-IO/qqq-cli.git",
    "directory": "packages/conformance"
  },
  "type": "module",
  "main": "dist/conformance.js",
  "types": "dist/conformance.d.ts",
  "bin": {
    "qqq-ui-api-conformance": "dist/main.js",
    "qqq-dev-idp": "dist/dev-idp.js"
  },
  "files": [
    "dist",
    "!dist/test",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node ../../scripts/run-tests.mjs dist/test",
    "prepack": "node ../../scripts/copy-license.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0"
  }
}
